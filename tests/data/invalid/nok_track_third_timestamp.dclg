<?xml version="1.0" encoding="UTF-8"?>
<doclang xmlns="https://www.doclang.ai/ns/v0">
  <!-- a cue block allows at most a start and an end timestamp -->
  <track>
    <bdiv/>
    <minutes value="0"/><seconds value="1"/>
    <minutes value="0"/><seconds value="2"/>
    <minutes value="0"/><seconds value="3"/>
  </track>
</doclang>
